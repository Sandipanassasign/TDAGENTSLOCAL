# ─── Jira ───────────────────────────────────────────────
# Self-hosted Jira (jira.yourcompany.com) — use a Personal Access Token
# Generate at: Jira → Your Profile (top-right avatar) → Personal Access Tokens → Create
JIRA_BASE_URL=https://jira.yourcompany.com
JIRA_PAT=your_jira_personal_access_token_here
JIRA_PROJECT_KEY=BANK

# ─── Confluence ─────────────────────────────────────────
# Self-hosted Confluence — use a Personal Access Token
# Generate at: Confluence → Your Profile → Personal Access Tokens → Create
CONFLUENCE_BASE_URL=https://confluence.yourcompany.com
CONFLUENCE_PAT=your_confluence_personal_access_token_here
CONFLUENCE_SPACE_KEY=QEA
